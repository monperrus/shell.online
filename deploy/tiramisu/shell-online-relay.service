[Unit]
Description=shell.online relay (Cloudflare Worker under workerd)
Documentation=https://github.com/monperrus/shell.online/blob/main/deploy/tiramisu/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=martin
Group=martin
WorkingDirectory=/opt/shell-online/repo

# wrangler dev is the only supported way to run a Worker outside Cloudflare:
# it drives the same workerd runtime the platform uses, with Durable Objects,
# rate limiting and Analytics Engine simulated locally. See the README for
# what that does and does not give us.
#
# node is a snap on this machine. /snap/bin/node is a symlink to the snap
# launcher, which wants a home directory of its own and refuses one outside
# /home; the interpreter inside the snap is an ordinary ELF binary and runs
# without any of that. So the runtime is named directly, and wrangler is run
# as a script rather than through npx, which would only find the same file.
#
# The cost is that /snap/node/current moves when the snap refreshes. It is a
# symlink, so this path keeps working across refreshes, but a major-version
# refresh is a thing to check after.
ExecStart=/snap/node/current/bin/node /opt/shell-online/repo/node_modules/wrangler/bin/wrangler.js dev \
    --config /opt/shell-online/repo/wrangler.tiramisu.jsonc \
    --ip 127.0.0.1 \
    --port 8788 \
    --persist-to /opt/shell-online/state \
    --show-interactive-dev-session=false

# CI=1 keeps wrangler from drawing a TUI at a terminal that is not there, and
# from prompting for anything. Nothing here talks to a Cloudflare account.
Environment=CI=1
Environment=WRANGLER_SEND_METRICS=false
Environment=NO_COLOR=1

# wrangler keeps a little configuration of its own under $HOME. The service
# gets a home inside the deployment rather than the operator's, so that
# ProtectHome can stay on and the whole deployment is one directory.
Environment=HOME=/opt/shell-online/home

Restart=always
RestartSec=5s

# The worker needs the repo (assets, bundle) and its own state directory, and
# nothing else on the machine.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/shell-online/state /opt/shell-online/home /opt/shell-online/repo/.wrangler
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shell-online-relay

[Install]
WantedBy=multi-user.target
