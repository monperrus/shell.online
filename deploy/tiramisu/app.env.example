# The accounts app on tiramisu. Copy to /opt/shell-online/repo/app/.env.
#
# Nothing here is a Firebase secret. The server verifies Firebase ID tokens
# against Google's published JWKs and needs only the project id; the VITE_
# values are the public web-app configuration, compiled into the client and
# visible to anyone who loads the page. The only secret is the database
# password, which never leaves this machine.
#
# The client is built from these, so any VITE_ change needs
# `docker compose up --build`, not a restart.

# --- Firebase (from the Firebase console: Project settings > Your apps > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- This deployment
# Where browsers reach the app. Used for CORS and for the links the CLI is
# sent to, so it is the public origin, never the container's.
WEB_ORIGIN=https://app.shell.gakoy.com
# The relay this app lists sessions from, proxied through /relay/*.
RELAY_URL=https://shell.gakoy.com
VITE_RELAY_URL=https://shell.gakoy.com

# Bind the published port to loopback. This whole value is interpolated into
# the compose port spec, which is why it carries the address as well as the
# port: nginx is what faces the internet.
PORT=127.0.0.1:8083

# nginx sets X-Forwarded-For, and nothing reaches the container except through
# it, so the header can be believed here. Set it to 0 if that ever stops
# being true: trusting it otherwise lets a caller pick a new address per
# request and walk straight through the rate limits.
TRUST_PROXY=1

# --- Database. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Optional: invitation email. Without it, invitations are created but no
# mail is sent; the invite link still works if you pass it on yourself.
# MAIL_PROVIDER=sendgrid
# MAIL_API_KEY=
# MAIL_FROM=shell.gakoy.com <no-reply@gakoy.com>
