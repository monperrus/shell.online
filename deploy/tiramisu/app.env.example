# The accounts app on tiramisu. Copy to /opt/shell-online/repo/app/.env.
#
# Two secrets live here and nowhere else: the database password and Keycloak's
# first administrator password. The OIDC values are public by construction ---
# the issuer is a URL anyone can fetch, and the client id is compiled into a
# page anyone can read --- because a browser app cannot keep a secret, which
# is why it is a public PKCE client rather than one with a secret it would
# have to publish.
#
# The client is built from the VITE_ values, so changing one needs
# `docker compose up --build`, not a restart.

# --- Sign-in: Keycloak, on this machine
# The realm URL. This is what serves /.well-known/openid-configuration, and
# what appears in the `iss` of every token.
VITE_OIDC_ISSUER=https://auth.gakoy.com/realms/shell
# The public client registered in that realm. See keycloak-realm.json.
VITE_OIDC_CLIENT_ID=shell-online-app

# Where Keycloak thinks it is. It goes into the issuer and the discovery
# document, so it is the public address, not the container's.
KEYCLOAK_URL=https://auth.gakoy.com
# Loopback is added by the compose override; this is just the port number.
KEYCLOAK_PORT=8084

# The first administrator of the Keycloak instance, used to sign in to the
# admin console and create the realm's people. Not an account of the app.
# Generate with: openssl rand -base64 24
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- This deployment
# Where browsers reach the app. Used for CORS and for the links the CLI is
# sent to, so it is the public origin, never the container's.
WEB_ORIGIN=https://app.shell.gakoy.com
# The relay this app lists sessions from, proxied through /relay/*.
RELAY_URL=https://shell.gakoy.com
VITE_RELAY_URL=https://shell.gakoy.com

# Bind the published port to loopback. This whole value is interpolated into
# the compose port spec, which is why it carries the address as well as the
# port: nginx is what faces the internet.
PORT=127.0.0.1:8083

# nginx sets X-Forwarded-For, and nothing reaches the container except through
# it, so the header can be believed here. Set it to 0 if that ever stops
# being true: trusting it otherwise lets a caller pick a new address per
# request and walk straight through the rate limits.
TRUST_PROXY=1

# --- Database. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Optional: invitation email. Without it, invitations are created but no
# mail is sent; the invite link still works if you pass it on yourself.
# MAIL_PROVIDER=sendgrid
# MAIL_API_KEY=
# MAIL_FROM=shell.gakoy.com <no-reply@gakoy.com>
